{
    "$schema":  "node_modules/wrangler/config-schema.json",
    "name":  "research-hub-files",
    "main":  "src/index.ts",
    "compatibility_date":  "2025-01-01",
    "vars":  {
                 "SSO_BASE_URL":  "https://rpr-grobid-gateway.hpl-storage.workers.dev",
                 "FIREBASE_PROJECT_ID":  "hyperdatalab-researchhub",
                 "ALLOWED_ORIGINS":  "http://localhost:3000,https://researchhub.hyperdatalab.org,https://paperlab.hyperdatalab.org"
             },
    "r2_buckets":  [
                       {
                           "binding":  "FILES_BUCKET",
                           "bucket_name":  "research-hub-files"
                       }
                   ],
    "account_id":  "124949a79dc6c5894bc492942593cb51"
}
