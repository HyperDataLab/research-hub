{
  "name": "research-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --project worker/tsconfig.json",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:secrets:local": "node worker/scripts/load-firebase-service-account.mjs",
    "worker:secrets:deploy": "node worker/scripts/load-firebase-service-account.mjs --deploy",
    "worker:types": "wrangler types worker-configuration.d.ts --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "typescript": "^6.0.3",
    "wrangler": "^4.164.0"
  }
}
